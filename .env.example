# Copy this file to .env and fill in local secrets.

# Required for the Telegram preferences bot.
TELEGRAM_BOT_TOKEN=

# Required for the full worker mode.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
TELEGRAM_PASSWORD=
# Optional: Telethon StringSession from scripts/session_string_generator.py.
# If set, it takes precedence over TELEGRAM_SESSION_FILE and no interactive login is needed.
TELEGRAM_SESSION_STRING=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=
ANTHROPIC_VISION_MODEL=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# telegram_<your chat id>: adds that chat to the allowlist. Empty allowlists let anyone use the bot.
APARTMENT_HUNTER_PROFILE_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ALLOWED_USERNAMES=
TELEGRAM_ADMIN_CHAT_IDS=
APARTMENT_HUNTER_GOOGLE_MAPS_API_KEY=

# Local Postgres URL for non-Docker runs.
DATABASE_URL=postgres://apartment_hunter:apartment_hunter@localhost:5432/apartment_hunter?sslmode=disable

# Optional runtime settings.
TELEGRAM_SESSION_FILE=.telegram/userbot.session
TELEGRAM_MEDIA_DIR=.telegram/media
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_VISION_INPUT_PRICE_PER_MILLION_USD=0.40
OPENAI_VISION_CACHED_INPUT_PRICE_PER_MILLION_USD=0.10
OPENAI_VISION_OUTPUT_PRICE_PER_MILLION_USD=1.60
APARTMENT_HUNTER_GEOCODING_REGION="Batumi, Georgia"
APARTMENT_HUNTER_GEOCODING_LANGUAGE=en
APARTMENT_HUNTER_PIPELINE_LOG_DIR=.logs/pipeline
APARTMENT_HUNTER_GEOCODING_LOG_DIR=.logs/geocoding
APARTMENT_HUNTER_LOG_TO_STDOUT=false
